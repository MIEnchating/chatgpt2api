    {
      "name": "decode preserves duration",
      "hook": "protocols",
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "args": [
        {
          "model": "wan-3",
          "body": {
            "kind": "json",
            "value": {
              "model": "wan-3",
              "prompt": "A moving cloud",
              "duration": 10,
              "resolution": "480p"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "wan-3",
        "action": "text_to_video",
        "requestBody": {
          "model": "wan-3",
          "prompt": "A moving cloud",
          "duration": 10,
          "resolution": "480p"
        }
      }
    },
    {
      "name": "seconds is only a usage fact",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "model": "wan-3",
            "prompt": "A moving cloud",
            "duration": 10,
            "resolution": "480p"
          },
          "model": "wan-3",
          "upstreamModel": "wan-3",
          "baseUrl": "https://channel.example.com",
          "apiKey": "fixture-key",
          "files": [],
          "usagePurpose": "facts"
        }
      ],
      "expected": {
        "seconds": 10,
        "resolution": "480p"
      }
    },
