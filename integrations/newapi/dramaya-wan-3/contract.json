          "status_fields": [
            "status"
          ],
          "progress_fields": [
            "progress"
          ],
          "error_fields": [
            "error.message",
            "error",
            "errorCode"
          ],
          "queued_statuses": [
            "queued"
          ],
          "processing_statuses": [
            "running",
            "in_progress",
            "processing",
            "pending",
            "cancel_requested"
          ],
          "success_statuses": [
            "completed"
          ],
          "failure_statuses": [
            "failed",
            "cancelled",
            "expired"
          ],
          "result_fields": []
        },
        "provider": {
          "base_url": "https://video.dramaya.us",
          "auth_mode": "bearer",
          "auth_header": ""
        }
