{
  "version": 4,
  "contracts": [
    {
      "contract": {
        "name": "Dramaya Wan 3 视频",
        "models": [
          "wan-3"
        ],
        "priority": 0,
        "driver": "custom-video",
        "transport": {
          "local_material": "url",
          "multipart_file_field": "",
          "multipart_repeatable": false,
          "multipart_mixed_urls": false,
          "create_path": "/v1/videos",
          "query_path": "/v1/videos/{task_id}"
        },
        "artifact": {
          "mode": "task_content",
          "content_path": "/v1/videos/{task_id}/content",
          "auth": "relay",
          "allowed_hosts": []
        },
        "capability": {
          "sizes": [],
          "seconds": [
            5,
            10,
            15
          ],
          "resolutions": [
            "480p",
            "720p",
            "1080p"
          ],
          "default_size": "",
          "default_seconds": 5,
          "default_resolution": "480p",
          "references": {
            "image": 0,
            "video": 0,
            "audio": 0,
            "total": 0
          },
          "first_frame_image_limit": 0,
          "reference_mode": false,
          "audio_control": "none",
          "watermark": false,
          "prompt": {
            "required": true,
            "min_length": 0,
            "max_length": 0
          }
        },
        "generation": {
          "selection": "infer",
          "default_mode": "text-to-video",
          "modes": [
            {
              "id": "text-to-video",
              "label": "文生视频",
              "kind": "text",
              "request_value": "",
              "materials": {
                "first_frame": {
                  "min": 0,
                  "max": 0
                },
                "last_frame": {
                  "min": 0,
                  "max": 0
                },
                "image": {
                  "min": 0,
                  "max": 0
                },
                "video": {
                  "min": 0,
                  "max": 0
                },
                "audio": {
                  "min": 0,
                  "max": 0
                },
                "total": {
                  "min": 0,
                  "max": 0
                }
              }
            }
          ]
        },
        "rules": [],
        "request": {
          "duration_field": "duration",
          "duration_value_type": "number",
          "aspect_ratio_field": "",
          "resolution_field": "resolution",
          "generate_audio_field": "",
          "watermark_field": "",
          "generation_mode_field": "",
          "first_frame_field": "",
          "last_frame_field": "",
          "reference_images_field": "",
          "reference_videos_field": "",
          "reference_audios_field": ""
        },
        "polling": {
          "interval_seconds": 5,
          "timeout_seconds": 900,
          "task_id_fields": [
            "id"
