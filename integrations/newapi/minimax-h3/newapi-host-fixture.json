    {
      "name": "json mapped decoder",
      "hook": "protocols",
      "args": [
        {
          "model": "my-h3",
          "upstreamModel": "MiniMax H3",
          "body": {
            "kind": "json",
            "value": {
              "model": "my-h3",
              "prompt": "test",
              "seconds": 5,
              "size": "1376x768",
              "prompt_enhance": false
            }
          }
        }
      ],
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "expected": {
        "kind": "submit",
        "model": "my-h3",
        "action": "text_to_video",
        "requestBody": {
          "model": "my-h3",
          "prompt": "test",
          "seconds": 5,
          "size": "1376x768",
          "prompt_enhance": false
        }
      }
    },
