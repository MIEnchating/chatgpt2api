    {
      "name": "multipart alias decode",
      "hook": "protocols",
      "args": [
        {
          "model": "my-h3",
          "upstreamModel": "MiniMax H3",
          "body": {
            "kind": "multipart",
            "fields": {
              "model": [
                "my-h3"
              ],
              "prompt": [
                "test"
              ],
              "seconds": [
                "5"
              ],
              "size": [
                "1376x768"
              ],
              "prompt_enhance": [
                "false"
              ]
            },
            "files": [
              {
                "ref": "opaque:images",
                "field": "images",
                "filename": "images.bin",
                "mimeType": "image/png",
                "size": 32
              },
              {
                "ref": "opaque:reference_videos",
                "field": "reference_videos",
                "filename": "reference_videos.bin",
                "mimeType": "video/mp4",
                "size": 32
              },
              {
                "ref": "opaque:reference_audios",
                "field": "reference_audios",
                "filename": "reference_audios.bin",
                "mimeType": "audio/mpeg",
                "size": 32
              }
            ]
          }
        }
      ],
      "path": [
        "openai_video",
        "decodeRequest"
      ],
      "expected": {
        "kind": "submit",
        "model": "my-h3",
        "action": "image_to_video",
        "requestBody": {
          "model": "my-h3",
          "prompt": "test",
          "seconds": 5,
          "size": "1376x768",
          "prompt_enhance": false,
          "images": [
            "opaque:images"
          ],
          "reference_videos": [
            "opaque:reference_videos"
          ],
          "reference_audios": [
            "opaque:reference_audios"
          ]
        }
      }
    },
    {
      "name": "multipart opaque file forwarding",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "my-h3",
          "upstreamModel": "MiniMax H3",
          "baseUrl": "http://channel.example:3000/provider",
          "apiKey": "fixture-key",
          "files": [
            {
              "ref": "opaque:images",
              "field": "images",
              "filename": "images.bin",
              "mimeType": "image/png",
              "size": 32
            },
            {
              "ref": "opaque:reference_videos",
              "field": "reference_videos",
              "filename": "reference_videos.bin",
              "mimeType": "video/mp4",
              "size": 32
            },
            {
              "ref": "opaque:reference_audios",
              "field": "reference_audios",
              "filename": "reference_audios.bin",
              "mimeType": "audio/mpeg",
              "size": 32
            }
          ],
          "requestBody": {
            "model": "my-h3",
            "prompt": "test",
            "seconds": 5,
            "size": "1376x768",
            "prompt_enhance": false,
            "images": [
              "opaque:images"
            ],
            "reference_videos": [
              "opaque:reference_videos"
            ],
            "reference_audios": [
              "opaque:reference_audios"
            ]
          },
          "upstream": {
            "kind": "vendor"
          }
        }
      ],
      "expected": {
        "url": "http://channel.example:3000/provider/v1/videos",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer fixture-key"
        },
        "bodyType": "multipart",
        "parts": [
          {
            "name": "images",
            "fileRef": "opaque:images",
            "filename": "images.bin"
          },
          {
            "name": "reference_videos",
            "fileRef": "opaque:reference_videos",
            "filename": "reference_videos.bin"
          },
          {
            "name": "reference_audios",
            "fileRef": "opaque:reference_audios",
            "filename": "reference_audios.bin"
          },
          {
            "name": "model",
            "value": "MiniMax H3"
          },
          {
            "name": "prompt",
            "value": "test"
          },
          {
            "name": "prompt_enhance",
            "value": "false"
          },
          {
            "name": "seconds",
            "value": "5"
          },
          {
            "name": "size",
            "value": "1376x768"
          }
        ]
      }
    }
  ]
