    {
      "name": "poll queued",
      "hook": "parseTaskResult",
      "args": [
        {
          "taskId": "task-fixture"
        },
        {
          "id": "task-fixture",
          "status": "queued",
          "error": {
            "message": "failed fixture"
          }
        },
        {
          "status": 200,
          "headers": {}
        }
      ],
      "expected": {
        "status": "QUEUED"
