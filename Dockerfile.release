# syntax=docker/dockerfile:1.7
#
# Release-only runtime image. GoReleaser builds the chatgpt2api binary first,
# then uses this Dockerfile to package the Docker Hub image.

FROM node:22-bookworm-slim

ARG TARGETPLATFORM
WORKDIR /app
ENV PORT=80

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY $TARGETPLATFORM/chatgpt2api /app/chatgpt2api
COPY agent-runtime /app/agent-runtime
RUN cd /app/agent-runtime && npm ci --omit=dev --ignore-scripts

RUN mkdir -p /app/data && chmod +x /app/chatgpt2api

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT:-80}/health || exit 1

CMD ["/app/chatgpt2api"]
