# syntax=docker/dockerfile:1.7
#
# Release-only runtime image. GoReleaser builds the chatgpt2api binary first,
# then uses this Dockerfile to package the Docker Hub image.

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

ARG TARGETPLATFORM
WORKDIR /app
ENV PORT=8080

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY $TARGETPLATFORM/chatgpt2api /app/chatgpt2api
COPY agent-runtime /app/agent-runtime
RUN cd /app/agent-runtime && npm ci --omit=dev --ignore-scripts

# /app must be writable: the service persists admin settings to /app/.env.
RUN mkdir -p /app/data && chown node:node /app /app/data && chmod +x /app/chatgpt2api

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:${PORT:-8080}/health || exit 1

CMD ["/app/chatgpt2api"]
