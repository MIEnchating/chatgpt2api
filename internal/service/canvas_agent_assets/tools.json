  {
    "type": "function",
    "function": {
      "name": "create_script_node",
      "description": "创建新的原生脚本版本或分支，不修改项目标题；已有主稿整理优先 update_script_node 原位转换，避免重复创建。随后用 update_script_node 保存镜头、素材和已有素材关联。",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sourceNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        },
        "required": [
          "title",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_text_node",
      "description": "创建镜头、角色、产品、场景、声音说明和其他普通文本节点；不得用于首次正式主剧本。 脚本用途必须传 scriptNodeId 与 assetId（设定图）或 shotId（镜头），创建时同步关联；已有节点请用 update_script_node 关联并复用。镜头提交前必须确认脚本且所需素材图已成功。",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sourceNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "scriptNodeId": {
            "type": "string",
            "description": "所属结构化脚本节点 ID；脚本素材或镜头生成必须提供，并且指定 assetId 或 shotId。"
          },
          "assetId": {
            "type": "string",
            "description": "脚本素材 ID，仅用于图片设定图；创建图片时同步写入素材 image_node_id，已有绑定须复用原节点。"
          },
          "shotId": {
            "type": "string",
            "description": "脚本镜头 ID；创建文本、图片或视频时同步绑定对应节点，媒体提示词同步写入镜头。与 assetId 互斥。"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_text_node",
      "description": "更新现有文本节点的标题或正文。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "nodeId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_script_node",
      "description": "保存脚本内的结构化分镜、角色/场景素材与提示词；也可原位把已有文本主稿转换为脚本，保持 nodeId、正文和连线。先 get_node 读取原稿、镜头及素材，再将分镜整理到 scriptProject；source_node_id 记录原镜头文本，image_node_id/video_node_id 关联已有素材。保留已有 shot/asset ID 和媒体绑定，不创建或重提生成任务。来源文本不会自动删除；删除仍使用原删除确认流程。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 12000
          },
          "scriptProject": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "confirmed": {
                "type": "boolean",
                "description": "内容修改仍会使确认失效。核对已保存脚本后使用 confirm_script_node 单独确认，不为确认而重写完整镜头或素材说明。"
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "character",
                        "scene",
                        "prop"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "image_node_id": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 120
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 60
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "framing": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "lighting": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "sound": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "camera": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "image_prompt": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "video_prompt": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "dialogue": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "dialogue",
                              "narration"
                            ]
                          },
                          "asset_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 12000
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    },
                    "asset_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "maxItems": 120
                    },
                    "color": {
                      "type": "string",
                      "enum": [
                        "",
                        "#ef6b68",
                        "#f5c542",
                        "#52c99b",
                        "#4bb7ef",
                        "#bdbdbd"
                      ]
                    },
                    "image_outdated": {
                      "type": "boolean",
                      "description": "已有分镜是否因脚本改动待更新"
                    },
                    "video_outdated": {
                      "type": "boolean",
                      "description": "已有视频是否因脚本改动待更新"
                    },
                    "source_node_id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "image_node_id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "video_node_id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "image_prompt_outdated": {
                      "type": "boolean",
                      "description": "Set false only after reviewing this prompt against the current shot."
                    },
                    "video_prompt_outdated": {
                      "type": "boolean",
                      "description": "Set false only after reviewing this prompt against the current shot."
                    }
                  },
                  "required": [
                    "id",
                    "seconds",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              }
            },
            "required": [
              "assets",
              "shots"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "nodeId",
          "scriptProject"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "confirm_script_node",
      "description": "确认刚刚读取并核对的原生脚本，只更新制作就绪状态，不重传或改写脚本、镜头、素材、提示词和人工质量记录，不提交媒体。先 get_node 读取完整脚本及 confirmationFingerprint，再原样传入指纹；版本变化时拒绝确认，重新读取核对。仅在用户已明确确认脚本，或委托自主创作并完整制作且没有要求先审核时使用；用户要求先审核或暂不生成时仍等待真实回答。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "maxLength": 128
          },
          "confirmationFingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "description": "get_node 返回的已核对脚本指纹，必须原样传入。"
          }
        },
        "required": [
          "nodeId",
          "confirmationFingerprint"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_node",
