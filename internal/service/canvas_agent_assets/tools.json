  {
    "type": "function",
    "function": {
      "name": "arrange_nodes",
      "description": "整理指定节点；不传 nodeIds 时整理当前画布顶层节点。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeIds": {
