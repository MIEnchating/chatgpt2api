  {
    "type": "function",
    "function": {
      "name": "update_script_node",
      "description": "保存脚本内的结构化分镜、角色/场景资产与提示词；也可原位把已有文本主稿转换为脚本，保持 nodeId、正文和连线。先 get_node 读取原稿、镜头及素材，再将分镜整理到 scriptProject；source_node_id 记录原镜头文本，image_node_id/video_node_id 关联已有素材。保留已有 shot/asset ID 和媒体绑定，不创建或重提生成任务。来源文本不会自动删除；删除仍使用原删除确认流程。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 12000
          },
          "scriptProject": {
            "type": "object",
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "confirmed": {
                "type": "boolean"
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "character",
                        "scene",
                        "prop"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "image_node_id": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 120
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 60
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "framing": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "lighting": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "sound": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "camera": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "image_prompt": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "video_prompt": {
                      "type": "string",
                      "maxLength": 12000
                    },
                    "dialogue": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "dialogue",
                              "narration"
                            ]
                          },
                          "asset_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 12000
                          }
                        },
                        "required": [
                          "id",
                          "kind",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    },
                    "asset_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "maxItems": 120
                    },
                    "color": {
                      "type": "string",
                      "enum": [
                        "",
                        "#ef6b68",
                        "#f5c542",
                        "#52c99b",
                        "#4bb7ef",
                        "#bdbdbd"
                      ]
                    },
                    "source_node_id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "image_node_id": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "video_node_id": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "id",
                    "seconds",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              }
            },
            "required": [
              "assets",
              "shots"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "nodeId",
          "scriptProject"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_node",
      "description": "原位编辑已有节点的标题、正文/媒体提示词、生成参数及来源引用，保留节点 ID、脚本关联、已有媒体和任务记录，不创建节点或提交生成。先 get_node 核对；修复已有镜头优先用本工具，再按用户授权 generate_node；只有明确要求新版本才创建新节点。生成中的节点需等待结束。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "现有文本正文、脚本原稿或媒体提示词；结构化分镜用 update_script_node。"
          },
          "sourceNodeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "显式替换该节点的全部上游来源连线，并按顺序重建媒体参考。省略保留连线；空数组解除来源。不得引用自身。"
          },
          "attachmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "重建媒体参考时使用的当前会话附件 ID，不能填写 URL。未传 sourceNodeIds 时沿用当前上游节点。"
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "description": "仅保存提供的参数，省略字段保留原值。model 只能使用当前配置的对应类型模型。修改不会清空原任务、错误或成品，重试生成需要用户授权。",
            "properties": {
              "model": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "quality": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 15
              },
              "seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "generateAudio": {
                "type": "boolean"
              },
              "referenceMode": {
                "type": "string",
                "enum": [
                  "reference",
                  "first-frame"
                ]
              },
              "voice": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "speed": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              },
              "instructions": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "nodeId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
