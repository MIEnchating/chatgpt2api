[
  {
    "type": "function",
    "function": {
      "name": "ask_user_question",
      "description": "仅在真正阻塞的歧义、约束冲突、超出已有范围或需要真实用户审核时提问。同阶段必要缺口合并为一次提问；常规默认、技术错误或配置通知不使用此工具，已回答或接受的限制不重复确认。调用后暂停，不得同批执行依赖答案的操作；沉默或超时不代表批准。",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "options": {
            "type": "array",
            "description": "可比较的建议选项；第一项必须是 Agent 最推荐的方案，界面会标注推荐。没有合适选项时传空数组，让用户直接输入。用户始终可以自由输入或修改选项。",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "maxItems": 4
          },
          "kind": {
            "type": "string",
            "enum": [
              "clarification",
              "confirmation"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "media_generation",
              "workflow_review"
            ],
            "description": "普通需求、范围、方案确认必须省略此字段。媒体生成授权使用 media_generation；只有工具已返回 requiresUserReview=true 且存在待审核系列提示词时才使用 workflow_review。"
          }
        },
        "required": [
          "question",
          "reason",
          "options",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_plan",
      "description": "保存复杂任务的简短执行计划与当前进度。简单请求无需计划。最多一个步骤进行中，完成状态必须依据实际工具结果；待生成任务不能标为完成。用户暂不生成时，将生成及依赖成品的步骤标为 deferred，继续其他步骤。",
      "parameters": {
        "type": "object",
        "properties": {
          "explanation": {
            "type": "string",
            "description": "可选的计划说明，无需补充说明时可省略。",
            "maxLength": 500
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "title": {
                  "type": "string",
                  "maxLength": 160
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "completed",
                    "deferred"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_canvas_summary",
      "description": "读取当前画布的轻量节点索引和必要状态，不含节点正文、连线全集或完整生成配置。详情按 ID 调用专用读取工具。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  {
