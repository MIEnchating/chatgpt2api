  {
    "type": "function",
    "function": {
      "name": "get_node",
      "description": "按真实节点 ID 读取节点。脚本的 production 按镜头顺序一次返回当前绑定的分镜图片、视频任务状态、实测属性、过期标记和已有质量记录；canMerge 仅表示技术上可合并，不代表质量通过，无需再为相同状态逐个读取视频。图片节点同时提供原图作为视觉输入。mediaMetadata 为已探测的实测时长、尺寸与音轨，mediaProbeError 表示探测失败；generation 仅为请求参数，不得当作实测结果。",
      "parameters": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          }
        },
        "required": [
          "nodeId"
        ],
        "additionalProperties": false
      }
    }
  },
