            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "size": {
            "type": "string"
          },
          "quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
