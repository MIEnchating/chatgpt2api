# 环境变量示例
# 复制为 .env 后填写真实值。包含密码、Token、密钥或数据库连接串的 .env 不要提交。
# 新变量名优先；升级时旧版 CHATGPT2API_*、RELAY_* 名称仍可兼容读取，建议按 README 逐步迁移。

# ==================== 管理员 ====================

# 初始管理员账号；管理员创建后修改此项不会重命名现有账号。
ADMIN_USERNAME=admin

# 初始管理员密码；留空时首次启动生成一次性密码并输出到日志。
# ADMIN_PASSWORD=change_me_please

# ==================== 外部地址与上游 ====================

# 图片访问地址：用于生成图片 URL，不要以斜杠结尾。
IMAGE_BASE_URL=https://image.yunmian.tech

# API 访问地址：请求转发到的 NewAPI / Sub2API 服务地址，不要以斜杠结尾。
API_BASE_URL=https://www.yunmian.tech

# 上游用户数据库只读连接：用于普通用户登录和读取本人可用的 Key。
# 该数据库账号建议只有 SELECT 权限。
# DATABASE_URL=postgresql://readonly:password@postgres:5432/relay?sslmode=disable

# 上游数据库结构类型：newapi 或 sub2api，默认 newapi。
DATABASE_TYPE=newapi

# 全局代理：支持 http、https、socks5、socks5h。
# PROXY=http://127.0.0.1:7890

# ==================== 模型 ====================

# 图片生成可用模型：创作台、无限画布和图片生成接口共用。
# 多个模型用英文逗号分隔；未指定模型时使用第一项。
IMAGE_MODELS=gpt-image-2,gemini-3.1-flash-image,grok-imagine-image

# 视频生成可用模型：创作台、无限画布和视频生成接口共用。
# 多个模型用英文逗号分隔；未指定模型时使用第一项。
VIDEO_MODELS=sora-2,grok-imagine-video-1.5,kling-v3,MiniMax-Hailuo-2.3,doubao-seedance-2-5-260628

# ==================== 任务与账号策略 ====================

# 账号池限流状态检查间隔，单位分钟，默认 5。
# REFRESH_ACCOUNT_INTERVAL_MINUTE=5

# 异步创作任务超时时间，适用于图片、视频和聊天任务。
# 单位秒，默认 300，允许范围 30-3600。
# CREATION_TASK_TIMEOUT_SECONDS=300

# 普通用户默认创作并发额度：每张图片占 1 个额度，视频和聊天任务各占 1 个额度。
# 0 表示不限制；管理员不受此限制。
# USER_DEFAULT_CONCURRENT_LIMIT=0

# 普通用户默认创作任务提交频率；每次提交计 1 次请求。
# 单位为次/分钟（RPM）；0 表示不限制，管理员不受此限制。
# USER_DEFAULT_RPM_LIMIT=0

# 文本账号池调度模式：load_balance（负载均衡）或 fill_first（优先用满一个账号）。
# TEXT_ACCOUNT_SCHEDULE_MODE=load_balance

# 图片账号池调度模式：load_balance（负载均衡）或 fill_first（优先用满一个账号）。
# IMAGE_ACCOUNT_SCHEDULE_MODE=load_balance

# ==================== 图片存储 ====================

# 图片原图存储后端：local 或 s3，默认 local。
# IMAGE_STORAGE_BACKEND=local

# 生成图片和会话参考图的保留天数，默认 30。
# IMAGE_RETENTION_DAYS=30

# 生成图片、缩略图、元数据和会话参考图的总容量上限。
# 单位 MB；0 表示不按容量自动清理。
# IMAGE_STORAGE_LIMIT_MB=0

# S3 兼容对象存储配置。启用 IMAGE_STORAGE_BACKEND=s3 时必须配置 Endpoint、Bucket、Access Key 和 Secret Key。
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=cloud-cotton-images
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
# S3_PREFIX=images
# S3_USE_PATH_STYLE=false

# ==================== 日志与账号治理 ====================

# 业务日志保留天数，默认 7。
# LOG_RETENTION_DAYS=7

# 默认日志视图：all、meaningful 或 business，默认 meaningful。
# DEFAULT_LOG_VIEW=meaningful

# 自动移除失效账号，默认 false。
# AUTO_REMOVE_INVALID_ACCOUNTS=false

# 自动移除限流账号，默认 false。
# AUTO_REMOVE_RATE_LIMITED_ACCOUNTS=false

# 需要写入业务日志的级别；英文逗号分隔。留空表示记录全部级别。
# LOG_LEVELS=warning,error

# ==================== 登录页与站点外观 ====================

# 网站名称，默认 云棉。
# APP_TITLE=云棉

# 项目名称，默认跟随 APP_TITLE。
# PROJECT_NAME=云棉

# 网站图标 URL；也可以在管理端上传。
# SITE_ICON_URL=

# 登录页背景图片及布局参数；也可以在管理端在线设置。
# LOGIN_PAGE_IMAGE_URL=
# LOGIN_PAGE_IMAGE_MODE=contain
# LOGIN_PAGE_IMAGE_ZOOM=1
# LOGIN_PAGE_IMAGE_POSITION_X=50
# LOGIN_PAGE_IMAGE_POSITION_Y=50

# ==================== 业务数据库 ====================

# 本服务业务数据的存储后端：sqlite、postgres 或 mysql，默认 sqlite。
STORAGE_BACKEND=sqlite

# SQLite 默认使用 /app/data/chatgpt2api.db。
# PostgreSQL / MySQL 部署时填写业务数据库连接串，不要与上游 DATABASE_URL 混用。
# STORAGE_DATABASE_URL=postgresql://user:password@host:5432/chatgpt2api

# ==================== Docker ====================

# 容器镜像；生产环境建议固定版本标签。
DOCKER_IMAGE=mienvirtuoso/chatgpt2api:latest

# 反向代理所在的外部 Docker 网络。
DOCKER_NETWORK=newapi_default

# 容器时区。
TZ=Asia/Shanghai

# ==================== 服务运行（可选） ====================

# HTTP 监听端口；Docker 镜像默认 80，直接运行二进制时默认 8000。
# PORT=80

# 项目根目录；通常无需设置，仅用于非标准目录结构或本地开发。
# ROOT_DIR=/app
